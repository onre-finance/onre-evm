# Copy to `.env`. Read by gemforge.config.cjs via dotenv.

# --- Deployment wallet -------------------------------------------------------
# Used by the `testnet` and `mainnet` targets. The `local` target uses anvil's
# default mnemonic and ignores this.
PRIVATE_KEY=

# --- Networks ----------------------------------------------------------------
SEPOLIA_RPC_URL=
MAINNET_RPC_URL=
ETHERSCAN_API_KEY=

# --- Initializer arguments ---------------------------------------------------
# Only read on a brand-new deployment; upgrades never re-run the initializer.
#
# The deployment wallet receives a bootstrap UPGRADER_ROLE from the DiamondProxy
# constructor so it can sign the first diamondCut. OnReDiamondInit revokes that
# grant unless the wallet is ONRE_UPGRADER itself. So:
#   - to keep iterating with `gemforge deploy` on local/testnet, set
#     ONRE_UPGRADER to the deployment wallet's address;
#   - for mainnet, set it to the upgrade multisig. The `mainnet` target uses
#     upgrades.manualCut, so gemforge prints the diamondCut calldata for the
#     multisig to execute instead of sending it.
ONRE_BOSS=
ONRE_ADMIN=
ONRE_WORKER=
ONRE_UPGRADER=

# Optional, at most two.
ONRE_APPROVER_1=
ONRE_APPROVER_2=

# --- CREATE3 -----------------------------------------------------------------
# 32-byte hex salt. The diamond address is derived from (deployer, salt), so the
# same pair yields the same address on every chain. Leave empty and gemforge
# randomises it on a fresh deployment; set it to reproduce a known address.
ONRE_CREATE3_SALT=
