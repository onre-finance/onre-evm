{
  "name": "@onre/evm",
  "version": "0.0.0",
  "private": true,
  "description": "OnRe EVM diamond contracts, built and deployed with Gemforge",
  "license": "MIT",
  "scripts": {
    "build": "gemforge build",
    "test": "gemforge build && forge test -vvv",
    "coverage": "gemforge build && forge coverage",
    "deploy:local": "gemforge deploy local",
    "deploy:testnet": "gemforge deploy testnet",
    "deploy:testnet:dry": "gemforge deploy testnet --dry -v",
    "deploy:mainnet_test": "gemforge deploy mainnet_test",
    "deploy:mainnet_test:dry": "gemforge deploy mainnet_test --dry -v",
    "deploy:mainnet_live": "gemforge deploy mainnet_live",
    "deploy:mainnet_live:dry": "gemforge deploy mainnet_live --dry -v",
    "query:testnet": "gemforge query testnet",
    "query:mainnet_test": "gemforge query mainnet_test",
    "query:mainnet_live": "gemforge query mainnet_live",
    "verify:testnet": "gemforge verify testnet",
    "verify:mainnet_test": "gemforge verify mainnet_test",
    "verify:mainnet_live": "gemforge verify mainnet_live",
    "devnet": "anvil",
    "test:integration": "bash scripts/test-gemforge-integration.sh"
  },
  "devDependencies": {
    "dotenv": "^16.6.1",
    "gemforge": "2.18.2",
    "solhint": "^6.2.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@9.15.4"
}
